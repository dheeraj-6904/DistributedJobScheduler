{
  "title": "Distributed Job Scheduler Dashboard",
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 36,
  "panels": [
    {
      "type": "timeseries",
      "title": "Queue Backlog (Jobs Waiting in Redis)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(max by (topic) (jobs_queue_backlog))",
          "legendFormat": "Pending Jobs",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Worker Throughput (Jobs/sec: Queued In vs Processed)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(jobs_processed_total[1m]))",
          "legendFormat": "Processed - Total Cluster (Jobs/sec)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(jobs_queued_total[1m]))",
          "legendFormat": "Queued In - Total (Jobs/sec)",
          "refId": "B"
        },
        {
          "expr": "rate(jobs_processed_total[1m])",
          "legendFormat": "Worker {{instance}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Avg Time Waiting in Queue (ms)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(jobs_queue_time_milliseconds_sum[1m])) / sum(rate(jobs_queue_time_milliseconds_count[1m]))",
          "legendFormat": "Queue Wait Time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ms"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Avg Job Execution Time (Cluster & Per-Worker ms)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(jobs_execution_time_milliseconds_sum[1m])) / sum(rate(jobs_execution_time_milliseconds_count[1m]))",
          "legendFormat": "Cluster Avg",
          "refId": "A"
        },
        {
          "expr": "rate(jobs_execution_time_milliseconds_sum[1m]) / rate(jobs_execution_time_milliseconds_count[1m])",
          "legendFormat": "Worker {{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ms"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Avg Total Lifecycle Time (ms)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(jobs_total_lifecycle_time_milliseconds_sum[1m])) / sum(rate(jobs_total_lifecycle_time_milliseconds_count[1m]))",
          "legendFormat": "Total Time (API to Finished)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "ms"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "In-Flight Jobs per Worker",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(jobs_in_flight)",
          "legendFormat": "Total Cluster In-Flight",
          "refId": "A"
        },
        {
          "expr": "jobs_in_flight",
          "legendFormat": "Worker {{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      }
    }
  ]
}
